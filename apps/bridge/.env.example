# Copy to apps/bridge/.env (gitignored) and fill in. Never commit .env.

# The ADCC web app. Must be on 127.0.0.1 or localhost: the bridge never sends data off this machine.
ADCC_WEB_URL=http://127.0.0.1:3000

# Same value as ADCC_BRIDGE_TOKEN in apps/web/.env. At least 32 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADCC_BRIDGE_TOKEN=

# Folders whose Claude Code and Codex sessions ADCC may read, separated by ';'. Transcript folders that
# can't belong to one are never opened; sessions started anywhere else are never sent.
# Example: D:\Projects;C:\Work\app
BRIDGE_APPROVED_FOLDERS=

# Optional overrides. Defaults: %USERPROFILE%\.claude\projects, the npm-installed claude.exe,
# and %USERPROFILE%\.codex (Codex's own CODEX_HOME; sessions are read from its sessions folder).
CLAUDE_PROJECTS_DIR=
CLAUDE_EXE=
CODEX_HOME=

# Seconds between scans (5–300).
BRIDGE_POLL_SECONDS=10
