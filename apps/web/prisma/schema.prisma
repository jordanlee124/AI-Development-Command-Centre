// ADCC database schema. Change only via `pnpm db:migrate` (see DEVELOPMENT.md).
// Conventions: UUIDv7 ids, timestamptz, snake_case table names.
// Parent deletes are Restrict wherever user data hangs off them, so a stray delete fails loudly.
// Projects are archived first; deleting one is an explicit, confirmed project-service action.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum MilestoneStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AgentSource {
  CLAUDE_CODE
  CODEX
}

model Project {
  id          String        @id @default(uuid(7)) @db.Uuid
  name        String        @db.VarChar(200)
  slug        String        @unique @db.VarChar(100)
  description String?
  status      ProjectStatus @default(ACTIVE)
  /// Absolute Windows path of the working folder; used to map agent sessions to projects.
  localPath   String?       @unique
  archivedAt  DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  repositories   Repository[]
  milestones     Milestone[]
  tasks          Task[]
  agentSessions  AgentSession[]
  activityEvents ActivityEvent[]

  @@index([archivedAt])
  @@map("projects")
}

model Repository {
  id                String    @id @default(uuid(7)) @db.Uuid
  projectId         String?   @db.Uuid
  /// GitHub owner/name, stored lowercase (GitHub names are case-insensitive).
  owner             String    @db.VarChar(100)
  name              String    @db.VarChar(100)
  /// GitHub's numeric repo id; null until first sync.
  githubId          BigInt?   @unique
  defaultBranch     String?   @db.VarChar(255)
  description       String?
  htmlUrl           String?   @db.VarChar(500)
  isPrivate         Boolean?
  /// Last successful sync. The GitHub tables below hold what that sync saw.
  lastSyncedAt      DateTime? @db.Timestamptz(3)
  /// Last attempt, successful or not; drives background sync spacing.
  lastSyncAttemptAt DateTime? @db.Timestamptz(3)
  /// Error from the last attempt; null once a sync succeeds.
  lastSyncError     String?
  /// Failed attempts since the last success; background sync backs off on it.
  syncFailures      Int       @default(0)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  activityEvents ActivityEvent[]
  branches       GitHubBranch[]
  commits        GitHubCommit[]
  pullRequests   GitHubPullRequest[]
  issues         GitHubIssue[]
  workflowRuns   GitHubWorkflowRun[]

  @@unique([owner, name])
  @@index([projectId])
  @@map("repositories")
}

// GitHub cache (ADR-015): read-only copies from the last successful sync, replaced whole on
// each sync. Not user data; values from GitHub are varchar, not enums (ADR-008).

model GitHubBranch {
  repositoryId String  @db.Uuid
  name         String  @db.VarChar(255)
  headSha      String  @db.VarChar(64)
  protected    Boolean

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@id([repositoryId, name])
  @@map("github_branches")
}

/// Recent commits on the default branch.
model GitHubCommit {
  repositoryId String   @db.Uuid
  sha          String   @db.VarChar(64)
  /// First line of the commit message.
  message      String
  authorName   String?  @db.VarChar(255)
  authorLogin  String?  @db.VarChar(100)
  committedAt  DateTime @db.Timestamptz(3)
  url          String   @db.VarChar(500)

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@id([repositoryId, sha])
  @@index([repositoryId, committedAt])
  @@map("github_commits")
}

model GitHubPullRequest {
  repositoryId     String    @db.Uuid
  number           Int
  title            String
  /// open | closed | merged
  state            String    @db.VarChar(20)
  draft            Boolean
  authorLogin      String?   @db.VarChar(100)
  headRef          String    @db.VarChar(255)
  baseRef          String    @db.VarChar(255)
  url              String    @db.VarChar(500)
  openedAt         DateTime  @db.Timestamptz(3)
  githubUpdatedAt  DateTime  @db.Timestamptz(3)
  closedAt         DateTime? @db.Timestamptz(3)
  mergedAt         DateTime? @db.Timestamptz(3)
  /// Derived from reviews (summarizeReviews); null for closed PRs, whose reviews aren't fetched.
  reviewStatus     String?   @db.VarChar(30)
  approvals        Int?
  changesRequested Int?
  reviewsRequested Int?

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@id([repositoryId, number])
  @@index([repositoryId, githubUpdatedAt])
  @@map("github_pull_requests")
}

/// Issues only; GitHub's issues endpoint also returns PRs, which the sync drops.
model GitHubIssue {
  repositoryId    String    @db.Uuid
  number          Int
  title           String
  /// open | closed
  state           String    @db.VarChar(20)
  authorLogin     String?   @db.VarChar(100)
  comments        Int
  labels          String[]
  url             String    @db.VarChar(500)
  openedAt        DateTime  @db.Timestamptz(3)
  githubUpdatedAt DateTime  @db.Timestamptz(3)
  closedAt        DateTime? @db.Timestamptz(3)

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@id([repositoryId, number])
  @@index([repositoryId, githubUpdatedAt])
  @@map("github_issues")
}

model GitHubWorkflowRun {
  repositoryId    String   @db.Uuid
  githubId        BigInt
  name            String?  @db.VarChar(255)
  title           String
  branch          String?  @db.VarChar(255)
  headSha         String   @db.VarChar(64)
  event           String   @db.VarChar(100)
  /// queued | in_progress | completed | …
  status          String   @db.VarChar(30)
  /// success | failure | cancelled | …; null until completed
  conclusion      String?  @db.VarChar(30)
  runNumber       Int
  url             String   @db.VarChar(500)
  githubCreatedAt DateTime @db.Timestamptz(3)
  githubUpdatedAt DateTime @db.Timestamptz(3)

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@id([repositoryId, githubId])
  @@index([repositoryId, githubCreatedAt])
  @@map("github_workflow_runs")
}

model Milestone {
  id          String          @id @default(uuid(7)) @db.Uuid
  projectId   String          @db.Uuid
  title       String          @db.VarChar(200)
  description String?
  status      MilestoneStatus @default(PLANNED)
  dueDate     DateTime?       @db.Date
  completedAt DateTime?       @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  tasks   Task[]

  @@unique([projectId, title])
  @@index([projectId, status])
  @@map("milestones")
}

model Task {
  id            String       @id @default(uuid(7)) @db.Uuid
  projectId     String       @db.Uuid
  /// Must belong to the same project; enforced in the task service.
  milestoneId   String?      @db.Uuid
  title         String       @db.VarChar(300)
  description   String?
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  dueDate       DateTime?    @db.Date
  /// AI tool the task is meant for. Assignment only: nothing runs a task (ADR-005).
  assignedAgent AgentSource?
  completedAt   DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  project        Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  milestone      Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  activityEvents ActivityEvent[]
  dependencies   TaskDependency[] @relation("dependent")
  dependents     TaskDependency[] @relation("dependency")
  comments       TaskComment[]

  @@index([projectId, status])
  @@index([milestoneId])
  @@map("tasks")
}

/// taskId can't start until dependsOnId is finished. Same project, no cycles: task service.
model TaskDependency {
  taskId      String   @db.Uuid
  dependsOnId String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  task      Task @relation("dependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("dependency", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
  @@map("task_dependencies")
}

model TaskComment {
  id        String   @id @default(uuid(7)) @db.Uuid
  taskId    String   @db.Uuid
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

/// One Claude Code or Codex session, read from its local session file (ADR-004).
model AgentSession {
  id                 String      @id @default(uuid(7)) @db.Uuid
  source             AgentSource
  /// Session id as written by the agent tool itself.
  externalId         String      @db.VarChar(200)
  projectId          String?     @db.Uuid
  cwd                String?
  gitBranch          String?     @db.VarChar(255)
  title              String?
  /// Provider-specific metadata from the bridge, as [{ label, value }] (Codex client, version…).
  details            Json?
  sourcePath         String
  startedAt          DateTime?   @db.Timestamptz(3)
  lastEventAt        DateTime?   @db.Timestamptz(3)
  endedAt            DateTime?   @db.Timestamptz(3)
  /// Records in the source file that failed validation and were not ingested.
  skippedRecordCount Int         @default(0)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)

  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  events         AgentEvent[]
  usageRecords   UsageRecord[]
  activityEvents ActivityEvent[]

  @@unique([source, externalId])
  @@index([projectId, startedAt])
  @@index([lastEventAt])
  @@map("agent_sessions")
}

/// One record from a session file. (sessionId, externalId) makes re-ingestion idempotent.
model AgentEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  sessionId  String   @db.Uuid
  /// Record id from the source file, or a parser-assigned stable key (e.g. "line:42").
  externalId String   @db.VarChar(200)
  type       String   @db.VarChar(100)
  role       String?  @db.VarChar(50)
  occurredAt DateTime @db.Timestamptz(3)
  summary    String?
  payload    Json
  sourceLine Int
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  usage   UsageRecord?

  @@unique([sessionId, externalId])
  @@index([sessionId, occurredAt])
  @@map("agent_events")
}

/// Token counts reported by the agent tool for one event. Cost is computed, never stored (ADR-004).
model UsageRecord {
  id               String   @id @default(uuid(7)) @db.Uuid
  sessionId        String   @db.Uuid
  eventId          String   @unique @db.Uuid
  model            String   @db.VarChar(200)
  occurredAt       DateTime @db.Timestamptz(3)
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  reasoningTokens  Int      @default(0)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  event   AgentEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([occurredAt])
  @@index([model, occurredAt])
  @@map("usage_records")
}

/// Unified timeline entry. Derived from real events only; dedupeKey stops double inserts.
model ActivityEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  type           String   @db.VarChar(100)
  occurredAt     DateTime @db.Timestamptz(3)
  title          String   @db.VarChar(500)
  description    String?
  /// e.g. "github:commit:<sha>"; null for events that can't repeat.
  dedupeKey      String?  @unique @db.VarChar(300)
  metadata       Json?
  projectId      String?  @db.Uuid
  repositoryId   String?  @db.Uuid
  taskId         String?  @db.Uuid
  agentSessionId String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  repository   Repository?   @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  task         Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  agentSession AgentSession? @relation(fields: [agentSessionId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([projectId, occurredAt])
  @@index([type, occurredAt])
  @@map("activity_events")
}

/// Key/value app settings. Validate each key's value with a Zod schema in src/domain before writing.
model ApplicationSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("application_settings")
}
