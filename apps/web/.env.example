# Copy to apps/web/.env (gitignored) and fill in. Never commit .env.
# Read by Next.js, the Prisma CLI, and docker compose (env_file).

# PostgreSQL container. Use a URL-safe password: letters and digits only.
POSTGRES_USER=adcc
POSTGRES_PASSWORD=
POSTGRES_DB=adcc

# Used by the web app and Prisma. Must match the values above.
DATABASE_URL=postgresql://adcc:<POSTGRES_PASSWORD>@127.0.0.1:55432/adcc?schema=public

# Optional. Fine-grained GitHub token with READ-ONLY repository permissions (Metadata, Contents,
# Pull requests, Issues, Actions); see DEVELOPMENT.md. Blank = GitHub not connected.
GITHUB_TOKEN=

# Background GitHub sync interval in minutes: 0 = off, else 5–1440. Manual refresh always works.
GITHUB_SYNC_INTERVAL_MINUTES=15

# Agent Bridge (apps/bridge) shared secret, at least 32 characters. Put the same value in
# apps/bridge/.env. Blank = the bridge API answers 503 and the AI Agents page says so.
ADCC_BRIDGE_TOKEN=
