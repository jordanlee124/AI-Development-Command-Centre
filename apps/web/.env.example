# Copy to apps/web/.env (gitignored) and fill in. Never commit .env.
# Read by Next.js, the Prisma CLI, and docker compose (env_file).

# PostgreSQL container. Use a URL-safe password: letters and digits only.
POSTGRES_USER=adcc
POSTGRES_PASSWORD=
POSTGRES_DB=adcc

# Used by the web app and Prisma. Must match the values above.
DATABASE_URL=postgresql://adcc:<POSTGRES_PASSWORD>@127.0.0.1:55432/adcc?schema=public
